# ---------------------------------------------------------------------------
# LLM Provider keys
# ---------------------------------------------------------------------------
# Set whichever keys you have. The frontend Settings UI lets the user pick
# between providers; the backend will use the key whose env var matches the
# requested provider.

# Google Gemini (default, unchanged)
GEMINI_API_KEY=AIzaSyC...你的Gemini API密钥...

# MiniMax (China endpoint by default). To use the global endpoint, set
# MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# CORS - allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.*

# API limits
MAX_REQUESTS_PER_MINUTE=60
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info
